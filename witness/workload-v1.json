{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,48}$"
          },
          "client": {
            "enum": [
              "old",
              "new"
            ]
          },
          "stage": {
            "enum": [
              "before",
              "after"
            ]
          },
          "sql": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "expect": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "budget_ms": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "client",
          "stage",
          "sql"
        ],
        "additionalProperties": false
      },
      "contains": {
        "properties": {
          "stage": {
            "const": "after"
          }
        }
      }
    }
  },
  "required": [
    "version",
    "requests"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
