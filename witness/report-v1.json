{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "environment": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer"
        },
        "fixture_sha256": {
          "type": "string"
        },
        "workload_version": {
          "type": "string"
        },
        "workload_sha256": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "runner": {
          "type": "string"
        },
        "statement_timeout_ms": {
          "type": "integer"
        },
        "observation_timeout_s": {
          "type": "number"
        },
        "index_writer_budget_ms": {
          "type": "integer"
        },
        "started_at": {
          "type": "string"
        }
      },
      "required": [
        "seed",
        "fixture_sha256",
        "workload_version",
        "workload_sha256",
        "platform",
        "python",
        "runner",
        "statement_timeout_ms",
        "observation_timeout_s",
        "index_writer_budget_ms",
        "started_at"
      ],
      "additionalProperties": false
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "pass",
              "application_failure",
              "budget_violation",
              "migration_failure",
              "recovered",
              "inconclusive"
            ]
          },
          "decision": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "migration",
                        "request",
                        "control"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "pid": {
                      "type": "integer"
                    },
                    "digest": {
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "sqlstate": {
                      "type": [
                        "null",
                        "string"
                      ],
                      "pattern": "^[0-9A-Z]{5}$"
                    },
                    "elapsed_ms": {
                      "type": "number"
                    },
                    "budget_ms": {
                      "type": [
                        "null",
                        "number"
                      ]
                    },
                    "over_budget": {
                      "type": "boolean"
                    },
                    "matched": {
                      "type": [
                        "null",
                        "boolean"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "name",
                    "pid",
                    "digest",
                    "sqlstate",
                    "elapsed_ms",
                    "budget_ms",
                    "over_budget",
                    "matched"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "stage"
                      ]
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "barrier"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "pid": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "kind",
                    "name",
                    "pid"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "wait"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "pid": {
                      "type": "integer"
                    },
                    "blockers": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "wait_type": {
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "wait_event": {
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "phase": {
                      "type": [
                        "null",
                        "string"
                      ]
                    },
                    "modes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "name",
                    "pid",
                    "blockers",
                    "wait_type",
                    "wait_event",
                    "phase",
                    "modes"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "catalog"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "exists": {
                      "type": "boolean"
                    },
                    "ready": {
                      "type": [
                        "null",
                        "boolean"
                      ]
                    },
                    "valid": {
                      "type": [
                        "null",
                        "boolean"
                      ]
                    },
                    "unique": {
                      "type": [
                        "null",
                        "boolean"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "name",
                    "exists",
                    "ready",
                    "valid",
                    "unique"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "postgres": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "verdict",
          "decision",
          "events",
          "postgres"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "environment",
    "trials"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
